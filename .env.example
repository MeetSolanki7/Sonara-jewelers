# ============================================================
# Jewellery Store PRO — copy this file to ".env" and fill it
# NEVER share real secrets on WhatsApp/GitHub. Keep only on server.
# ============================================================
PORT=3000
# Generate a long random secret (32+ chars) for each buyer:
JWT_SECRET=CHANGE-THIS-LONG-RANDOM-SECRET

# --- Razorpay (Payments: UPI/Cards/EMI) https://dashboard.razorpay.com ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# true = allow TEST payment modal when keys are empty (demo/sales only). Set false in production.
PAYMENTS_TEST_MODE=true

# --- Mobile OTP provider ---
# OTP_DEV_MODE=true shows OTP on screen for testing ONLY. Set false in production.
OTP_DEV_MODE=true
# Option A: MSG91 (India, DLT template needed)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Option B: Twilio Verify / SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Google Login (Google Cloud Console > OAuth Client ID for Web) ---
GOOGLE_CLIENT_ID=

# --- Email OTP (FREE — Gmail SMTP, no cost) ---
# Setup: Gmail → Google Account → Security → 2-Step Verification ON → App Passwords → create "Sonara Jewels"
# Use the 16-character app password below (NOT your Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-shop@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Sonara Jewels <your-shop@gmail.com>
