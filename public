        <div class="field"><label>Mobile Number *</label><input class="input" id="rPhone" required maxlength="10" inputmode="numeric" placeholder="10-digit mobile"><div class="hint">You can login with email OR this number.</div></div></div>
        <div class="field"><label>Password * (min 6 characters)</label><input class="input" id="rPw" type="password" required placeholder="Create a password"><div class="pw-meter"><div class="pw-meter-fill" id="pwFill"></div></div><div class="pw-label" id="pwLabel"></div></div>
        <div class="field"><label>Confirm Password *</label><input class="input" id="rPw2" type="password" required placeholder="Repeat password"></div>
        <button class="btn btn-gold btn-lg btn-block" type="submit">Create Account →</button>
      </form>
      <p class="center muted" style="margin-top:16px">Already have an account? <a href="#/login" style="color:var(--maroon);font-weight:800">Login</a></p>
      <p class="center small muted" style="margin-top:8px">New here? Use <b>WELCOME10</b> for 10% OFF your first order (min ₹999).</p>
    </div></div>`;
  // Live password strength meter
  const pwInput = $('#rPw'), pwFill = $('#pwFill'), pwLabel = $('#pwLabel');
  if(pwInput) pwInput.addEventListener('input', ()=>{
    const v = pwInput.value;
    let score = 0;
    if(v.length >= 8) score++;
    if(/[a-z]/.test(v) && /[A-Z]/.test(v)) score++;
    if(/\d/.test(v)) score++;
    if(/[^A-Za-z0-9]/.test(v)) score++;
    const cls = score<=1 ? 'weak' : score===2 ? 'fair' : score===3 ? 'good' : 'strong';
    const txt = score<=1 ? 'Weak — add length, numbers & symbols' : score===2 ? 'Fair' : score===3 ? 'Good' : 'Strong';
    pwFill.className = 'pw-meter-fill' + (v ? ' ' + cls : '');
    pwLabel.textContent = v ? txt : '';
    pwLabel.style.color = cls==='weak' ? '#ef4444' : cls==='fair' ? '#f59e0b' : '#059669';
  });
  $('#regForm').onsubmit = async e=>{
    e.preventDefault(); $('#regErr').innerHTML='';
    if($('#rPw').value !== $('#rPw2').value){ $('#regErr').innerHTML = '<div class="form-error">Passwords do not match.</div>'; shakeCard(); return; }
    const btn = e.target.querySelector('button[type=submit]'); setLoading(btn,true,'Creating account…');
    try {
      const r = await api('/api/auth/register', { method:'POST', body:{ name:$('#rName').value.trim(), email:$('#rEmail').value.trim(), phone:$('#rPhone').value.trim(), password:$('#rPw').value } });
      setSession(r.token, r.user); await mergeGuestCart(); await syncCartWish(); renderHeader();
      await showLoginSuccess(r.user.name);
      const red = sessionStorage.getItem('sonara_redirect'); sessionStorage.removeItem('sonara_redirect');
      go(red && red!=='#/login' ? red : '#/dashboard');
    } catch(err){ $('#regErr').innerHTML = `<div class="form-error">${esc(err.message)}</div>`; shakeCard(); setLoading(btn,false); }
  };
}

