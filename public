async function payOnline(){
  const created = await api('/api/payments/razorpay/order', { method:'POST', body:{ coupon: state.checkoutCoupon ? state.checkoutCoupon.code : '' } });
  if(created.mock){
    const ok = await testPayModal(created.total);
    const v = await api('/api/payments/razorpay/verify', { method:'POST', body:{ razorpay_order_id: created.id, mockSuccess: ok } });
    return { paymentId: v.paymentId, orderId: created.id, mock: true };
  }
  if(typeof Razorpay === 'undefined') throw new Error('Payment window failed to load. Please check internet and retry, or choose COD.');
  return new Promise((resolve, reject)=>{
    const rz = new Razorpay({
      key: created.keyId, amount: created.amount, currency: created.currency, order_id: created.id,
      name: (state.settings||{}).storeName || 'Sonara Jewels', description: 'Jewellery Order',
      prefill: { name: state.user.name, email: state.user.email, contact: state.user.phone },
      theme: { color: '#5C1A2B' },
      handler: async (resp)=>{
        try { const v = await api('/api/payments/razorpay/verify', { method:'POST', body: resp }); resolve({ paymentId: v.paymentId, orderId: created.id, mock:false }); }
        catch(e){ reject(e); }
      },
      modal: { ondismiss: ()=>reject(new Error('Payment cancelled. Your cart is safe — try again or choose COD.')) }
    });
    rz.on('payment.failed', ()=>reject(new Error('Payment failed. Please try another method or choose COD.')));
    rz.open();
  });
}
async function downloadCSV(pathUrl, filename){
  try {
    const res = await fetch(pathUrl, { headers: state.token ? { Authorization:'Bearer '+state.token, 'X-Auth-Token':state.token } : {} });
    if(!res.ok) throw new Error('Export failed ('+res.status+')');
    const blob = await res.blob();
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = filename; a.click();
    setTimeout(()=>URL.revokeObjectURL(a.href), 2000);
    toast('Export downloaded');
  } catch(e){ toast(e.message, 'err'); }
}
