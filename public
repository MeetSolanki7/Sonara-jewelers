/* ============ SONARA JEWELS — Clean Store Design (BlueStone/Amazon style) ============ */
:root{
  --ink:#1a1a1a; --ink2:#374151; --muted:#6b7280; --line:#e5e7eb; --line2:#d1d5db;
  --bg:#ffffff; --card:#ffffff; --soft:#f9fafb; --soft2:#f3f4f6;
  --gold:#b8860b; --gold2:#d4af37; --gold-dark:#8a5d00;
  --maroon:#8a2432; --maroon2:#6d1a27; --green:#067d62; --red:#cc0c39; --blue:#1d4ed8; --amber:#b45309;
  --radius:10px; --radius-lg:14px;
  --shadow:0 1px 3px rgba(0,0,0,.08); --shadow-lg:0 8px 30px rgba(0,0,0,.12);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--ink);line-height:1.55;font-size:15px}
h1,h2,h3,h4{font-weight:700;letter-spacing:-.2px}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer}
input,select,textarea{font-family:inherit;font-size:.95rem}
img{max-width:100%;display:block}
.hidden{display:none!important}
.muted{color:var(--muted)} .small{font-size:.82rem} .center{text-align:center}
.wrap{max-width:1280px;margin:0 auto;padding:0 20px}
.only-mobile{display:none}

/* ---------- Buttons / inputs / pills ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:8px;padding:10px 20px;font-weight:600;font-size:.92rem;transition:.15s;white-space:nowrap;background:#fff}
.btn:active{transform:scale(.98)}
.btn-gold{background:var(--maroon);color:#fff}
.btn-gold:hover{background:var(--maroon2)}
.btn-maroon{background:var(--maroon);color:#fff}.btn-maroon:hover{background:var(--maroon2)}
.btn-outline{background:#fff;border-color:var(--line2);color:var(--ink)}.btn-outline:hover{border-color:var(--ink);background:var(--soft)}
.btn-ghost{background:transparent;border-color:var(--line);color:var(--ink2)}.btn-ghost:hover{background:var(--soft)}
.btn-danger{background:#fff;border-color:#fecdd3;color:var(--red)}.btn-danger:hover{background:#fff1f2}
.btn-sm{padding:7px 14px;font-size:.85rem;border-radius:8px}
.btn-lg{padding:13px 26px;font-size:.98rem}
.btn-block{width:100%}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn .spin{width:15px;height:15px;border:2.5px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:inline-block}
@keyframes spin{to{transform:rotate(360deg)}}
.input,select.input,textarea.input{width:100%;padding:10px 13px;border:1px solid var(--line2);border-radius:8px;background:#fff;color:var(--ink);outline:none;transition:.15s}
.input:focus{border-color:var(--maroon);box-shadow:0 0 0 3px rgba(138,36,50,.12)}
.field{margin-bottom:14px}.field label{display:block;font-size:.85rem;font-weight:600;color:var(--ink2);margin-bottom:6px}
.field .hint{font-size:.78rem;color:var(--muted);margin-top:4px}
.form-error{background:#fff1f2;border:1px solid #fecdd3;color:#9f1239;padding:10px 14px;border-radius:8px;font-size:.88rem;margin-bottom:14px}
.form-ok{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:10px 14px;border-radius:8px;font-size:.88rem;margin-bottom:14px}
.pill{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:6px;font-size:.74rem;font-weight:600}
.pill-gold{background:#fef9e7;color:var(--gold-dark)}.pill-silver{background:#f3f4f6;color:#4b5563}.pill-rose{background:#fff1f2;color:#9f1239}
.pill-green{background:#ecfdf5;color:#065f46}.pill-red{background:#fff1f2;color:var(--red)}.pill-amber{background:#fffbeb;color:#92400e}.pill-blue{background:#eff6ff;color:var(--blue)}.pill-grey{background:#f3f4f6;color:#6b7280}
.chip{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border:1px solid var(--line2);border-radius:999px;background:#fff;font-weight:500;font-size:.88rem;transition:.15s}
.chip:hover{border-color:var(--ink)} .chip.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.badge{position:absolute;top:-6px;right:-8px;background:var(--red);color:#fff;font-size:.66rem;min-width:18px;height:18px;border-radius:999px;display:flex;align-items:center;justify-content:center;padding:0 5px;font-weight:700}

/* ---------- Header ---------- */
.announce{background:var(--ink);color:#fff;text-align:center;padding:8px 14px;font-size:.83rem;font-weight:500;display:flex;align-items:center;justify-content:center;gap:12px}
.announce button{background:rgba(255,255,255,.15);border:none;color:#fff;width:26px;height:26px;border-radius:50%;font-size:.75rem;flex-shrink:0}
.announce button:hover{background:rgba(255,255,255,.3)}
.header{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:60}
.header.scrolled{box-shadow:0 2px 12px rgba(0,0,0,.08)}
.header-in{max-width:1280px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;gap:20px}
.logo{display:flex;align-items:center;gap:10px;flex-shrink:0}
.logo-mark{width:40px;height:40px;border-radius:8px;background:var(--maroon);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.3rem;font-weight:800}
.logo-text{font-weight:800;font-size:1.15rem;line-height:1.05;color:var(--ink);letter-spacing:-.3px}
.logo-text em{color:var(--maroon);font-style:normal}
.logo-text small{display:block;font-size:.56rem;letter-spacing:2px;color:var(--muted);font-weight:600}
.main-nav{display:flex;gap:2px}
.main-nav a{padding:8px 12px;border-radius:8px;font-weight:500;font-size:.92rem;color:var(--ink2)}
.main-nav a:hover{background:var(--soft);color:var(--ink)}
.header-search{flex:1;display:flex;align-items:center;gap:8px;background:var(--soft);border:1px solid var(--line);border-radius:999px;padding:9px 16px;max-width:420px;margin-left:auto}
.header-search:focus-within{border-color:var(--maroon);background:#fff}
.header-search input{border:none;background:transparent;outline:none;flex:1;font-size:.9rem;min-width:0}
.header-actions{display:flex;align-items:center;gap:4px;margin-left:auto}
.h-action{position:relative;display:flex;flex-direction:column;align-items:center;padding:6px 10px;border-radius:8px;font-size:.68rem;font-weight:600;color:var(--ink2)}
.h-action:hover{background:var(--soft)} .h-ico{font-size:1.15rem;line-height:1}
.icon-btn{background:#fff;border:1px solid var(--line2);border-radius:8px;width:40px;height:40px;font-size:1.05rem}
.rate-strip{border-top:1px solid var(--soft2);background:var(--soft)}
.rate-strip-in{max-width:1280px;margin:0 auto;padding:6px 20px;display:flex;gap:22px;flex-wrap:wrap;font-size:.79rem;color:var(--ink2)}
.rate-strip b{color:var(--maroon)}
.user-chip{display:flex;align-items:center;gap:8px;background:var(--soft);border:1px solid var(--line);padding:5px 12px 5px 5px;border-radius:999px;font-weight:600;font-size:.85rem}
.avatar{width:30px;height:30px;border-radius:50%;background:var(--maroon);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.82rem;flex-shrink:0}
.mobile-nav{background:#fff;border-bottom:1px solid var(--line);padding:10px 20px;display:flex;flex-direction:column;gap:2px;position:sticky;top:65px;z-index:55}
.mobile-nav a{padding:10px 8px;border-radius:8px;font-weight:500}.mobile-nav a:hover{background:var(--soft)}

/* ---------- Hero / storefront ---------- */
.hero{background:var(--soft);border-bottom:1px solid var(--line)}
.hero-in{max-width:1280px;margin:0 auto;padding:48px 20px;display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center}
.hero h1{font-size:clamp(1.9rem,4vw,3rem);line-height:1.15;font-weight:800;letter-spacing:-.8px}
.hero h1 span{color:var(--maroon)}
.hero p{color:var(--ink2);margin:16px 0 24px;font-size:1rem;max-width:540px}
.hero-cta{display:flex;gap:12px;flex-wrap:wrap}
.hero-img{border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--line);position:relative;background:#fff}
.hero-img img{width:100%;height:380px;object-fit:cover}
.hero-img .float-tag{position:absolute;bottom:14px;left:14px;background:rgba(255,255,255,.96);color:var(--ink);padding:10px 16px;border-radius:10px;font-size:.83rem;box-shadow:var(--shadow)}
.rate-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:26px;max-width:540px}
.rate-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:13px 14px}
.rate-card small{color:var(--muted);font-weight:600;letter-spacing:.5px;font-size:.66rem}
.rate-card b{display:block;font-size:1.15rem;margin-top:3px;color:var(--maroon)}
.rate-card span{font-size:.74rem;color:var(--muted)}
.trust-bar{background:#fff;border-bottom:1px solid var(--line)}
.trust-in{max-width:1280px;margin:0 auto;padding:18px 20px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.trust-item{display:flex;gap:11px;align-items:flex-start;font-size:.85rem}
.trust-item .t-ico{font-size:1.4rem;line-height:1}.trust-item b{display:block;font-size:.88rem}
.section{max-width:1280px;margin:0 auto;padding:40px 20px 8px}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:20px;flex-wrap:wrap}
.section-head h2{font-size:1.4rem;font-weight:700;letter-spacing:-.4px}
.section-head p{color:var(--muted);font-size:.9rem;margin-top:2px}
.metal-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.metal-card{border-radius:var(--radius-lg);padding:24px;color:#fff;position:relative;overflow:hidden;min-height:170px;display:flex;flex-direction:column;justify-content:flex-end;transition:.2s;border:1px solid rgba(0,0,0,.06)}
.metal-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}
.mc-gold{background:#8a5d00}
.mc-silver{background:#374151}
.mc-imitation{background:var(--maroon)}
.metal-card h3{font-size:1.35rem}.metal-card p{opacity:.92;font-size:.88rem;margin:4px 0 12px}
.metal-card .mc-emoji{position:absolute;top:16px;right:20px;font-size:2.6rem;opacity:.9}
.cat-row{display:flex;gap:10px;flex-wrap:wrap}
.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.testi{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:20px}
.testi .stars{color:#f59e0b;letter-spacing:2px}
.offers-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.offer-card{background:#fff;border:1px dashed var(--gold2);border-radius:var(--radius-lg);padding:18px;text-align:center}
.offer-card b{font-size:1.1rem;color:var(--maroon)}
.offer-card code{background:var(--ink);color:#fff;padding:3px 12px;border-radius:6px;font-weight:700;letter-spacing:1px;font-size:.8rem}

/* Category circles (BlueStone style) */
.cat-circles{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:18px}
.cat-circle{text-align:center}
.cat-circle .cc-img{width:96px;height:96px;border-radius:50%;overflow:hidden;margin:0 auto 8px;border:1px solid var(--line);background:var(--soft);transition:.2s}
.cat-circle:hover .cc-img{border-color:var(--maroon);transform:scale(1.04)}
.cat-circle img{width:100%;height:100%;object-fit:cover}
.cat-circle span{font-size:.85rem;font-weight:600;color:var(--ink2)}
.cat-circle:hover span{color:var(--maroon)}

/* ---------- Product cards ---------- */
.pgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:18px}
.pcard{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden;transition:.2s;display:flex;flex-direction:column}
.pcard:hover{border-color:var(--line2);box-shadow:var(--shadow-lg)}
.pcard-img{position:relative;height:230px;overflow:hidden;background:var(--soft)}
.pcard-img img{width:100%;height:100%;object-fit:cover;transition:.3s}
.pcard:hover .pcard-img img{transform:scale(1.04)}
.pcard-badges{position:absolute;top:10px;left:10px;display:flex;flex-direction:column;gap:5px}
.wish-btn{position:absolute;top:10px;right:10px;width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:#fff;font-size:1rem;transition:.2s;z-index:2}
.wish-btn:hover{transform:scale(1.1)} .wish-btn.on{background:#fff1f2;border-color:#fecdd3}
.pcard .quick-add{position:absolute;left:10px;right:10px;bottom:10px;background:rgba(26,26,26,.92);color:#fff;border:none;border-radius:8px;padding:10px;font-weight:600;font-size:.85rem;opacity:0;transform:translateY(8px);transition:.2s;z-index:2}
.pcard:hover .quick-add{opacity:1;transform:none}
@media(hover:none){.pcard .quick-add{opacity:1;transform:none;padding:8px;font-size:.78rem}}
.pcard-body{padding:14px 15px 16px;display:flex;flex-direction:column;gap:5px;flex:1}
.pcard-name{font-weight:600;font-size:.95rem;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.pcard-name:hover{color:var(--maroon)}
.pcard-meta{font-size:.76rem;color:var(--muted);display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.stars{color:#f59e0b;font-size:.82rem;letter-spacing:1px}
.stars span{color:var(--muted);letter-spacing:0}
.price-row{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-top:auto}
.price{font-size:1.15rem;font-weight:800;color:var(--ink)}
.mrp{color:var(--muted);text-decoration:line-through;font-size:.85rem}
.off{color:var(--green);font-weight:700;font-size:.8rem}
.stock-note{font-size:.76rem;font-weight:600}
.pcard-actions{display:flex;gap:8px;margin-top:8px}
.pcard-actions .btn{flex:1;padding:9px 8px;font-size:.85rem}

/* ---------- Shop layout / filters ---------- */
.shop-layout{max-width:1280px;margin:0 auto;padding:28px 20px 60px;display:grid;grid-template-columns:260px 1fr;gap:26px;align-items:start}
.filters{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:20px;position:sticky;top:120px}
.filters h3{font-size:1.05rem;margin-bottom:6px}
.f-group{border-top:1px solid var(--soft2);padding:14px 0 4px}
.f-group h4{font-size:.78rem;letter-spacing:.8px;color:var(--ink2);margin-bottom:10px;text-transform:uppercase}
.f-check{display:flex;align-items:center;gap:9px;padding:5px 0;font-size:.9rem;cursor:pointer}
.f-check input{accent-color:var(--maroon);width:16px;height:16px}
.price-inputs{display:flex;gap:8px;align-items:center}.price-inputs .input{padding:8px 10px}
.shop-toolbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:18px}
.shop-toolbar .input{width:auto}
.result-note{color:var(--muted);font-size:.88rem;margin-right:auto}
.result-note b{color:var(--ink)}
.active-filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}

/* ---------- Skeleton / empty / loading ---------- */
.skel{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden}
.skel .sk{height:230px;background:linear-gradient(100deg,#f3f4f6 40%,#e5e7eb 50%,#f3f4f6 60%);background-size:200% 100%;animation:shimmer 1.3s infinite}
.skel .skl{height:13px;border-radius:7px;margin:12px 16px;background:linear-gradient(100deg,#f3f4f6 40%,#e5e7eb 50%,#f3f4f6 60%);background-size:200% 100%;animation:shimmer 1.3s infinite}
@keyframes shimmer{to{background-position:-200% 0}}
.empty{background:#fff;border:1.5px dashed var(--line2);border-radius:var(--radius-lg);padding:54px 24px;text-align:center;max-width:640px;margin:26px auto}
.empty .e-ico{font-size:3.4rem;margin-bottom:10px}
.empty h3{font-size:1.35rem;margin-bottom:6px}
.empty p{color:var(--muted);margin-bottom:18px}
.page-loading{padding:90px 20px;text-align:center;color:var(--muted)}
.spinner{width:40px;height:40px;border:3px solid var(--soft2);border-top-color:var(--maroon);border-radius:50%;margin:0 auto 14px;animation:spin .8s linear infinite}

/* ---------- Product detail ---------- */
.pdetail{max-width:1280px;margin:0 auto;padding:28px 20px 60px}
.crumbs{font-size:.84rem;color:var(--muted);margin-bottom:16px}
.crumbs a:hover{color:var(--maroon);text-decoration:underline}
.pd-grid{display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:start}
.pd-img{border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--line);position:relative;background:var(--soft)}
.pd-img img{width:100%;height:520px;object-fit:cover}
.pd-info h1{font-size:1.7rem;line-height:1.3}
.breakup{background:var(--soft);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;margin:16px 0;font-size:.9rem}
.breakup .row{display:flex;justify-content:space-between;padding:4px 0}
.breakup .row.total{border-top:1px dashed var(--line2);margin-top:7px;padding-top:9px;font-weight:800;font-size:1.02rem}
.spec-table{width:100%;border-collapse:collapse;font-size:.9rem}
.spec-table td{padding:9px 12px;border-bottom:1px solid var(--soft2)}
.spec-table td:first-child{color:var(--muted);width:170px;font-weight:600}
.qty-box{display:inline-flex;align-items:center;border:1px solid var(--line2);border-radius:8px;overflow:hidden;background:#fff}
.qty-box button{width:38px;height:40px;border:none;background:var(--soft);font-size:1.1rem;font-weight:700}
.qty-box b{min-width:36px;text-align:center}
.review-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;margin-bottom:12px}

/* ---------- Cart / checkout ---------- */
.two-col{max-width:1280px;margin:0 auto;padding:28px 20px 60px;display:grid;grid-template-columns:1fr 380px;gap:26px;align-items:start}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:22px}
.card h3{font-size:1.1rem;margin-bottom:14px}
.cart-item{display:flex;gap:16px;padding:16px 0;border-bottom:1px solid var(--soft2);align-items:flex-start}
.cart-item img{width:92px;height:92px;object-fit:cover;border-radius:var(--radius);border:1px solid var(--line)}
.cart-item:last-child{border-bottom:none}
.sum-row{display:flex;justify-content:space-between;padding:6px 0;font-size:.93rem}
.sum-row.total{border-top:1px dashed var(--line2);margin-top:9px;padding-top:12px;font-weight:800;font-size:1.08rem}
.ship-progress{background:var(--soft);border-radius:var(--radius);padding:12px 14px;font-size:.84rem;margin-bottom:14px}
.ship-bar{height:8px;background:var(--soft2);border-radius:99px;overflow:hidden;margin-top:7px}
.ship-bar div{height:100%;background:var(--maroon);border-radius:99px;transition:.4s}
.coupon-row{display:flex;gap:8px}.coupon-row .input{flex:1;text-transform:uppercase}
.pay-opt{display:flex;gap:12px;border:1px solid var(--line2);border-radius:var(--radius);padding:14px 16px;margin-bottom:10px;cursor:pointer;align-items:flex-start;background:#fff}
.pay-opt:has(input:checked){border-color:var(--maroon);background:var(--soft)}
.pay-opt input{margin-top:3px;accent-color:var(--maroon)}
.addr-card{border:1px solid var(--line2);border-radius:var(--radius);padding:16px 18px;margin-bottom:12px;background:#fff}
.addr-card.sel{border-color:var(--maroon);background:var(--soft)}
.steps{display:flex;gap:0;align-items:center;margin:6px 0 22px;flex-wrap:wrap}
.step{display:flex;align-items:center;gap:8px;font-weight:600;font-size:.87rem;color:var(--muted)}
.step .n{width:28px;height:28px;border-radius:50%;background:var(--soft2);display:flex;align-items:center;justify-content:center;font-size:.8rem}
.step.done{color:var(--green)} .step.done .n{background:var(--green);color:#fff}
.step.now{color:var(--maroon)} .step.now .n{background:var(--maroon);color:#fff}
.step-line{flex:1;height:2px;background:var(--soft2);margin:0 10px;min-width:24px}
.success-hero{text-align:center;padding:56px 20px;max-width:720px;margin:0 auto}
.success-hero .big-tick{font-size:4.2rem}

/* ---------- Auth ---------- */
.auth-wrap{max-width:1080px;margin:0 auto;padding:44px 20px 70px;display:grid;grid-template-columns:1fr 1fr;gap:0;border-radius:var(--radius-lg);overflow:hidden}
.auth-side{background:var(--ink);color:#fff;padding:44px 38px;border-radius:var(--radius-lg) 0 0 var(--radius-lg)}
.auth-side h2{font-size:1.8rem;line-height:1.3}
.auth-side ul{list-style:none;margin-top:20px;display:grid;gap:12px;font-size:.95rem;color:#d1d5db}
.auth-card{background:#fff;border:1px solid var(--line);border-left:none;padding:40px 38px;border-radius:0 var(--radius-lg) var(--radius-lg) 0}
.auth-card h2{font-size:1.5rem}
.demo-box{background:var(--soft);border:1px dashed var(--line2);border-radius:var(--radius);padding:16px;margin-top:20px}
.demo-box h4{font-size:.85rem;margin-bottom:10px}
.pass-wrap{position:relative}.pass-wrap .eye{position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;font-size:1rem;padding:6px}

/* ---------- Dashboard layout ---------- */
.dash{max-width:1280px;margin:0 auto;padding:26px 20px 60px;display:grid;grid-template-columns:262px 1fr;gap:24px;align-items:start}
.sidebar{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:18px 14px;position:sticky;top:118px}
.side-user{display:flex;gap:11px;align-items:center;padding:8px 10px 16px;border-bottom:1px solid var(--soft2);margin-bottom:12px}
.side-user b{display:block;line-height:1.2}.side-user small{color:var(--muted)}
.side-nav{display:flex;flex-direction:column;gap:3px}
.side-nav a,.side-nav button{display:flex;align-items:center;gap:10px;padding:11px 13px;border-radius:8px;font-weight:500;font-size:.92rem;color:var(--ink2);background:none;border:none;text-align:left;width:100%}
.side-nav a:hover,.side-nav button:hover{background:var(--soft)}
.side-nav a.on{background:var(--ink);color:#fff}
.side-label{font-size:.68rem;letter-spacing:1.4px;color:var(--muted);font-weight:700;padding:14px 13px 6px;text-transform:uppercase}
.dash-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:20px}
.dash-head h2{font-size:1.5rem}
.dash-head p{color:var(--muted);font-size:.9rem}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(205px,1fr));gap:16px;margin-bottom:22px}
.stat-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:19px}
.stat-card .s-ico{font-size:1.5rem}.stat-card b{display:block;font-size:1.45rem;margin:6px 0 2px}
.stat-card span{color:var(--muted);font-size:.82rem;font-weight:500}
.chart-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:22px;margin-bottom:22px}
.bar-chart{display:flex;align-items:flex-end;gap:12px;height:190px;padding-top:14px}
.bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;height:100%;justify-content:flex-end}
.bar{width:100%;max-width:52px;background:var(--maroon);border-radius:6px 6px 3px 3px;min-height:6px;transition:.5s;position:relative}
.bar-col small{color:var(--muted);font-weight:600;font-size:.74rem}
.bar-col .bv{font-size:.7rem;font-weight:700;color:var(--maroon)}
.dash-cols{display:grid;grid-template-columns:1.5fr 1fr;gap:22px;align-items:start}

/* ---------- Tables ---------- */
.table-wrap{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);overflow:auto}
table.tbl{width:100%;border-collapse:collapse;font-size:.89rem;min-width:640px}
.tbl th{text-align:left;background:var(--soft);color:var(--ink2);font-size:.74rem;letter-spacing:.7px;padding:13px 15px;border-bottom:1px solid var(--line);white-space:nowrap;text-transform:uppercase}
.tbl td{padding:13px 15px;border-bottom:1px solid var(--soft2);vertical-align:middle}
.tbl tr:hover td{background:var(--soft)}
.tbl .t-prod{display:flex;gap:11px;align-items:center;min-width:210px}
.tbl .t-prod img{width:48px;height:48px;border-radius:8px;object-fit:cover;border:1px solid var(--line)}
.row-actions{display:flex;gap:6px;flex-wrap:wrap}
.mini-select{padding:7px 9px;border:1px solid var(--line2);border-radius:8px;background:#fff;font-size:.83rem;font-weight:500}
.switch{position:relative;width:44px;height:24px;flex-shrink:0}
.switch input{opacity:0;width:0;height:0}
.switch .tr{position:absolute;inset:0;background:#d1d5db;border-radius:99px;transition:.2s;cursor:pointer}
.switch .tr:before{content:'';position:absolute;width:18px;height:18px;border-radius:50%;background:#fff;top:3px;left:3px;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.2)}
.switch input:checked+.tr{background:var(--green)} .switch input:checked+.tr:before{left:23px}

/* ---------- Orders / timeline ---------- */
.order-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:20px;margin-bottom:16px}
.order-head{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center}
.order-items{display:flex;gap:12px;flex-wrap:wrap;margin:13px 0}
.order-items .oi{display:flex;gap:9px;align-items:center;background:var(--soft);border:1px solid var(--line);padding:7px 12px 7px 7px;border-radius:10px;font-size:.83rem;font-weight:500}
.order-items .oi img{width:42px;height:42px;border-radius:8px;object-fit:cover}
.timeline{display:flex;gap:0;margin:16px 0 4px;overflow-x:auto;padding-bottom:4px}
.tl-step{flex:1;text-align:center;position:relative;min-width:86px;font-size:.74rem;color:var(--muted);font-weight:500}
.tl-step:before{content:'';position:absolute;top:9px;left:-50%;width:100%;height:2.5px;background:var(--soft2)}
.tl-step:first-child:before{display:none}
.tl-step .dot{width:20px;height:20px;border-radius:50%;background:#fff;border:2.5px solid var(--soft2);margin:0 auto 6px;position:relative;z-index:1;display:flex;align-items:center;justify-content:center;font-size:.6rem}
.tl-step.done{color:var(--green)} .tl-step.done .dot{background:var(--green);border-color:var(--green);color:#fff}
.tl-step.done:before{background:var(--green)}

/* ---------- Modal / toast ---------- */
.modal-back{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100;display:flex;align-items:flex-start;justify-content:center;padding:26px 14px;overflow-y:auto}
.modal{background:#fff;border-radius:var(--radius-lg);width:100%;max-width:640px;padding:28px;box-shadow:var(--shadow-lg);animation:pop .2s ease}
.modal.wide{max-width:820px}
@keyframes pop{from{transform:translateY(14px) scale(.98);opacity:0}}
.modal-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px}
.modal-head h3{font-size:1.25rem}
.x-btn{background:var(--soft);border:1px solid var(--line);width:36px;height:36px;border-radius:50%;font-size:1rem;flex-shrink:0}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.toast-root{position:fixed;bottom:20px;right:20px;z-index:200;display:flex;flex-direction:column;gap:10px;max-width:min(380px,92vw)}
.toast{background:#1a1a1a;color:#fff;padding:14px 18px;border-radius:10px;box-shadow:var(--shadow-lg);font-size:.9rem;display:flex;gap:10px;align-items:flex-start;animation:slideIn .25s ease;position:relative;overflow:hidden}
.toast.err{background:#7f1d1d}.toast.ok{background:#1a1a1a}
.toast .t-ico{font-size:1.05rem;flex-shrink:0}
.toast .t-bar{position:absolute;left:0;bottom:0;height:3px;background:rgba(255,255,255,.35);animation:tbar 3.4s linear forwards}
@keyframes slideIn{from{transform:translateX(30px);opacity:0}}
@keyframes tbar{from{width:100%}to{width:0}}

/* ---------- Footer ---------- */
.footer{background:#111827;color:#d1d5db;margin-top:70px}
.footer-grid{max-width:1280px;margin:0 auto;padding:52px 20px 30px;display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr 1.3fr;gap:30px}
.footer h4{color:#fff;margin-bottom:13px;font-size:1rem}
.footer a{display:block;padding:4px 0;color:#9ca3af;font-size:.9rem}.footer a:hover{color:#fff;text-decoration:underline}
.footer p{font-size:.88rem;padding:3px 0;color:#9ca3af}
.footer .logo-text{color:#fff}.footer-logo{margin-bottom:12px}
.news-form{display:flex;gap:8px;margin-top:10px}
.news-form input{flex:1;padding:10px 13px;border-radius:8px;border:1px solid #374151;background:#1f2937;color:#fff;outline:none;min-width:0}
.footer-bottom{border-top:1px solid #1f2937;text-align:center;padding:16px;font-size:.8rem;color:#6b7280}

/* ---------- Search suggestions ---------- */
.search-suggest{position:absolute;top:calc(100% + 8px);left:0;right:0;background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);overflow:hidden;z-index:80;max-height:380px;overflow-y:auto}
.search-suggest .ss-item{display:flex;gap:11px;align-items:center;padding:10px 14px;cursor:pointer}
.search-suggest .ss-item:hover{background:var(--soft)}
.search-suggest .ss-item img{width:42px;height:42px;border-radius:8px;object-fit:cover;border:1px solid var(--line)}
.search-suggest .ss-item b{font-size:.88rem;display:block;line-height:1.25}
.search-suggest .ss-item span{font-size:.78rem;color:var(--muted)}
.search-suggest .ss-empty{padding:16px;text-align:center;color:var(--muted);font-size:.88rem}
.search-suggest .ss-head{padding:10px 14px 4px;font-size:.7rem;font-weight:700;letter-spacing:1px;color:var(--muted)}

/* ---------- Mobile bottom navigation ---------- */
.bottom-nav{display:none}
@media(max-width:1024px){
  .bottom-nav{display:flex;position:fixed;bottom:0;left:0;right:0;background:rgba(255,255,255,.97);backdrop-filter:blur(10px);border-top:1px solid var(--line);z-index:70;padding:6px 4px calc(6px + env(safe-area-inset-bottom));box-shadow:0 -4px 20px rgba(0,0,0,.06)}
  .bottom-nav a{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:.64rem;font-weight:600;color:var(--ink2);padding:5px 2px;border-radius:8px;position:relative}
  .bottom-nav a.on{color:var(--maroon)}
  .bottom-nav a.on .bn-ico{transform:scale(1.15)}
  .bn-ico{font-size:1.25rem;line-height:1;transition:.15s}
  .bottom-nav .badge{top:0;right:calc(50% - 20px)}
  body{padding-bottom:66px}
  .footer{margin-bottom:0}
}
/* Back to top */
.to-top{position:fixed;right:18px;bottom:86px;width:46px;height:46px;border-radius:50%;border:1px solid var(--line);background:#fff;color:var(--ink);font-size:1.2rem;box-shadow:var(--shadow-lg);z-index:65;transition:.2s}
.to-top:hover{background:var(--ink);color:#fff;transform:translateY(-3px)}
@media(min-width:1025px){.to-top{bottom:24px}}

/* Accessibility */
:focus-visible{outline:3px solid rgba(138,36,50,.35);outline-offset:2px;border-radius:6px}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
img[loading="lazy"]{background:var(--soft)}

/* Print */
@media print{
  .header,.footer,.bottom-nav,.to-top,.announce,.toast-root,.no-print{display:none!important}
  body{background:#fff;padding:0}
  .order-card,.card{box-shadow:none;border:1px solid #ddd}
}

/* ---------- Responsive ---------- */
@media(max-width:1024px){
  .main-nav{display:none}.only-mobile{display:flex;align-items:center;justify-content:center}
  .header-search{display:none}
  .hero-in{grid-template-columns:1fr;padding:38px 20px}
  .hero-img img{height:280px}
  .trust-in{grid-template-columns:1fr 1fr}
  .metal-cards,.testi-grid{grid-template-columns:1fr}
  .offers-strip{grid-template-columns:1fr 1fr}
  .shop-layout{grid-template-columns:1fr}.filters{position:static}
  .pd-grid{grid-template-columns:1fr}.pd-img img{height:340px}
  .two-col{grid-template-columns:1fr}
  .auth-wrap{grid-template-columns:1fr;padding:26px 14px 50px}
  .auth-side{border-radius:var(--radius-lg) var(--radius-lg) 0 0}.auth-card{border-radius:0 0 var(--radius-lg) var(--radius-lg);border-left:1px solid var(--line)}
  .dash{grid-template-columns:1fr}.sidebar{position:static}
  .side-nav{flex-direction:row;flex-wrap:wrap}.side-nav a,.side-nav button{width:auto}
  .side-label{width:100%}
  .dash-cols{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr 1fr}
  .h-lbl{display:none}
}
@media(max-width:560px){
  .rate-cards{grid-template-columns:1fr 1fr}
  .trust-in{grid-template-columns:1fr}
  .offers-strip{grid-template-columns:1fr}
  .frow{grid-template-columns:1fr}
  .footer-grid{grid-template-columns:1fr}
  .pgrid{grid-template-columns:repeat(auto-fill,minmax(164px,1fr));gap:13px}
  .pcard-img{height:170px}
  .logo-text small{display:none}
  .modal{padding:20px}
  .cat-circles{grid-template-columns:repeat(auto-fill,minmax(84px,1fr));gap:12px}
  .cat-circle .cc-img{width:72px;height:72px}
}

/* ============ v3.1 — SVG icons + elegant serif (Tanishq style) ============ */
.h-ico, .bn-ico, .hs-ico{display:inline-flex;align-items:center;justify-content:center}
.h-ico svg{width:22px;height:22px}
.bn-ico svg{width:22px;height:22px}
.hs-ico{color:var(--muted);display:inline-flex}
.hs-ico svg{width:18px;height:18px}
.logo-text{font-family:'Playfair Display',Georgia,serif;font-weight:700;letter-spacing:.5px}
.logo-text em{color:var(--maroon);font-style:normal}
.logo-mark{font-family:'Playfair Display',Georgia,serif}
.hero h1{font-family:'Playfair Display',Georgia,serif;font-weight:600}
.section-head h2{font-family:'Playfair Display',Georgia,serif;font-weight:600}
.pd-info h1{font-family:'Playfair Display',Georgia,serif;font-weight:600}
.auth-side h2, .auth-card h2{font-family:'Playfair Display',Georgia,serif;font-weight:600}
.modal-head h3{font-family:'Playfair Display',Georgia,serif;font-weight:600}
.dash-head h2{font-family:'Playfair Display',Georgia,serif;font-weight:600}
/* Icon buttons inside cards/actions */
.wish-btn svg{width:18px;height:18px}
.wish-btn.on svg{fill:#e11d48;stroke:#e11d48}
.btn svg{width:16px;height:16px;flex-shrink:0}
.trust-item .t-ico svg{width:24px;height:24px;color:var(--maroon)}
.metal-card .mc-emoji svg{width:44px;height:44px;color:rgba(255,255,255,.9)}

/* ---------- GST Invoice ---------- */
.invoice{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:32px;max-width:900px;margin:0 auto}
.inv-head{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;border-bottom:2px solid var(--ink);padding-bottom:18px;margin-bottom:18px}
.inv-logo{font-family:'Playfair Display',Georgia,serif;font-size:1.6rem;font-weight:700}
.inv-logo em{color:var(--maroon);font-style:normal}
.inv-meta{text-align:right;font-size:.9rem;line-height:1.7}
.inv-title{font-size:1.15rem;font-weight:800;letter-spacing:1px;color:var(--maroon)}
.inv-parties{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;font-size:.92rem}
.inv-table{width:100%;border-collapse:collapse;font-size:.9rem;margin-bottom:16px}
.inv-table th{text-align:left;background:var(--soft);padding:10px 12px;border:1px solid var(--line);font-size:.78rem;text-transform:uppercase;letter-spacing:.5px}
.inv-table td{padding:10px 12px;border:1px solid var(--line);vertical-align:top}
.inv-table .right{text-align:right}
.inv-table .center{text-align:center}
.inv-totals{margin-left:auto;max-width:320px;font-size:.92rem}
.inv-totals .row{display:flex;justify-content:space-between;padding:5px 0}
.inv-totals .row.total{border-top:2px solid var(--ink);margin-top:8px;padding-top:10px;font-weight:800;font-size:1.05rem}
.inv-words{background:var(--soft);border-radius:8px;padding:12px 14px;margin:16px 0;font-size:.9rem}
.inv-terms{font-size:.8rem;color:var(--muted);line-height:1.7;border-top:1px dashed var(--line2);padding-top:14px;margin-top:14px}
.inv-sign{display:flex;justify-content:space-between;margin-top:36px;font-size:.85rem;color:var(--ink2)}
@media print{
  .invoice{border:none;padding:0;max-width:none}
  .inv-table th{background:#f3f4f6!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
}

/* ============ v3.5 — Unified Login Tabs + Surprise Features ============ */
/* --- Unified login tabs --- */
.auth-wrap-v2{max-width:980px}
.auth-card-v2{padding:34px 34px 30px}
.auth-tabs{display:flex;gap:6px;background:var(--soft2);border-radius:10px;padding:4px;margin-bottom:20px}
.auth-tab{flex:1;display:flex;align-items:center;justify-content:center;gap:6px;border:none;background:transparent;padding:10px 8px;border-radius:8px;font-weight:600;font-size:.86rem;color:var(--muted);transition:.15s;white-space:nowrap}
.auth-tab:hover{color:var(--ink)}
.auth-tab.on{background:#fff;color:var(--maroon);box-shadow:0 1px 4px rgba(0,0,0,.1)}
.auth-tab .pill{font-size:.62rem;padding:1px 6px}
.auth-panel{animation:fadeSlide .2s ease}
@keyframes fadeSlide{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
@media(max-width:560px){.auth-tab{font-size:.78rem;padding:9px 4px}.auth-card-v2{padding:26px 20px}}

/* --- Size guide modal --- */
.size-guide-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.size-guide-grid h4{font-size:.9rem;margin-bottom:8px;color:var(--maroon)}
.size-guide-grid table{width:100%;border-collapse:collapse;font-size:.85rem}
.size-guide-grid td,.size-guide-grid th{padding:6px 8px;border-bottom:1px solid var(--line);text-align:left}
.size-guide-grid th{color:var(--muted);font-weight:600;font-size:.78rem;text-transform:uppercase;letter-spacing:.5px}
@media(max-width:560px){.size-guide-grid{grid-template-columns:1fr}}

/* --- Price alert / notify --- */
.notify-box{background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:14px 16px;margin-top:12px}
.notify-box b{color:#92400e}

/* --- Share buttons --- */
.share-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.share-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:8px;font-size:.85rem;font-weight:600;border:1px solid var(--line2);background:#fff;transition:.15s}
.share-btn:hover{border-color:var(--ink);background:var(--soft)}

/* --- Recently viewed --- */
.recent-row{display:flex;gap:14px;overflow-x:auto;padding-bottom:8px;scroll-snap-type:x mandatory}
.recent-row .pcard{min-width:200px;max-width:200px;scroll-snap-align:start}
.recent-row::-webkit-scrollbar{height:6px}
.recent-row::-webkit-scrollbar-thumb{background:var(--line2);border-radius:3px}

/* --- Gold rate ticker --- */
.rate-ticker{background:var(--ink);color:#fff;overflow:hidden;padding:9px 16px;font-size:.82rem}
.rate-ticker-track{display:flex;justify-content:center;align-items:center;min-height:30px;transition:opacity .8s cubic-bezier(.4,0,.2,1), transform .8s cubic-bezier(.4,0,.2,1), filter .8s cubic-bezier(.4,0,.2,1);will-change:opacity,transform,filter}
.rate-ticker-track.fading{opacity:0;transform:translateY(8px) scale(.985);filter:blur(5px)}
.tick-group{display:flex;gap:14px;justify-content:center;align-items:center;flex-wrap:wrap}
.tick-pill{display:inline-flex;align-items:center;gap:6px;padding:4px 14px;border-radius:999px;font-weight:600;white-space:nowrap}
.tick-pill svg{flex-shrink:0}
.tick-gold{background:linear-gradient(135deg,#ffd970,#d4af37);color:#3d2c00;box-shadow:0 0 12px rgba(212,175,55,.45)}
.tick-gold b{color:#3d2c00;font-size:.95rem}
.tick-silver{background:linear-gradient(135deg,#e5e7eb,#c0c6ce);color:#1f2937;box-shadow:0 0 10px rgba(192,198,206,.35)}
.tick-silver b{color:#1f2937;font-size:.95rem}
.tick-green{background:#065f46;color:#a7f3d0}
.tick-green b{color:#fff}
.tick-blue{background:#1e3a5f;color:#93c5fd}
.tick-blue b{color:#fff}
.tick-rose{background:#5c1a2b;color:#fda4af}
.tick-rose b{color:#fff}
.tick-amber{background:#78350f;color:#fcd34d}
.tick-amber b{color:#fff}

/* --- Tools section on home --- */
.tools-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.tool-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:22px;transition:.15s;display:block}
.tool-card:hover{border-color:var(--gold);box-shadow:var(--shadow-lg);transform:translateY(-2px)}
.tool-card .t-ico{width:46px;height:46px;border-radius:12px;background:var(--soft);display:flex;align-items:center;justify-content:center;color:var(--maroon);margin-bottom:12px}
.tool-card h3{font-size:1rem;margin-bottom:6px}
.tool-card p{font-size:.86rem;color:var(--muted);margin-bottom:10px}
.tool-card .tool-link{font-size:.85rem;font-weight:700;color:var(--maroon);display:inline-flex;align-items:center;gap:4px}

/* --- Countdown timer --- */
.countdown-bar{background:linear-gradient(135deg,#8a2432,#6d1a27);color:#fff;border-radius:var(--radius-lg);padding:22px 26px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.countdown-bar h3{font-size:1.15rem}
.countdown-bar p{font-size:.88rem;opacity:.85}
.countdown-timer{display:flex;gap:8px}
.countdown-timer .cd-box{background:rgba(255,255,255,.14);border-radius:10px;padding:8px 12px;text-align:center;min-width:58px}
.countdown-timer .cd-box b{display:block;font-size:1.3rem;line-height:1}
.countdown-timer .cd-box span{font-size:.68rem;opacity:.8;text-transform:uppercase;letter-spacing:.5px}

/* --- Back in stock notify --- */
.notify-form{display:flex;gap:8px;margin-top:10px}
.notify-form input{flex:1}

/* --- Toast improvements --- */
.toast{animation:toastIn .25s ease}
@keyframes toastIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* ============ v3.6 — Animation & Polish Layer ============ */
/* --- 1. Animated mobile menu (slide-down + staggered links) --- */
.mobile-nav{max-height:0;opacity:0;overflow:hidden;transform:translateY(-8px);pointer-events:none;padding-top:0;padding-bottom:0;border-bottom:none;transition:max-height .38s cubic-bezier(.4,0,.2,1),opacity .3s ease,transform .3s ease,padding .3s ease,border-color .3s ease}
.mobile-nav.open{max-height:520px;opacity:1;transform:none;pointer-events:auto;padding-top:10px;padding-bottom:12px;border-bottom:1px solid var(--line)}
.mobile-nav a{opacity:0;transform:translateX(-10px)}
.mobile-nav.open a{animation:menuLinkIn .38s cubic-bezier(.4,0,.2,1) both}
.mobile-nav.open a:nth-child(1){animation-delay:.04s}.mobile-nav.open a:nth-child(2){animation-delay:.08s}
.mobile-nav.open a:nth-child(3){animation-delay:.12s}.mobile-nav.open a:nth-child(4){animation-delay:.16s}
.mobile-nav.open a:nth-child(5){animation-delay:.20s}.mobile-nav.open a:nth-child(6){animation-delay:.24s}
.mobile-nav.open a:nth-child(7){animation-delay:.28s}.mobile-nav.open a:nth-child(8){animation-delay:.32s}
.mobile-nav.open a:nth-child(9){animation-delay:.36s}.mobile-nav.open a:nth-child(10){animation-delay:.40s}
@keyframes menuLinkIn{from{opacity:0;transform:translateX(-12px)}to{opacity:1;transform:none}}
#btnMenu{transition:transform .25s ease,background .2s ease}
#btnMenu:hover{background:var(--soft)}
#btnMenu:active{transform:scale(.92)}

/* --- 2. Page transition on route change --- */
#view.view-enter{animation:viewIn .38s cubic-bezier(.4,0,.2,1)}
@keyframes viewIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}

/* --- 3. Scroll reveal (fade-up as you scroll) --- */
.reveal{opacity:0;transform:translateY(26px);transition:opacity .65s cubic-bezier(.4,0,.2,1),transform .65s cubic-bezier(.4,0,.2,1)}
.reveal.in{opacity:1;transform:none}
.pcard.reveal.in:hover{transform:translateY(-4px)}
@media (prefers-reduced-motion: reduce){
  .reveal{opacity:1;transform:none;transition:none}
  .mobile-nav a{opacity:1;transform:none;animation:none}
  #view.view-enter{animation:none}
}

/* --- 4. Modal close animation --- */
.modal-back{transition:opacity .22s ease}
.modal{transition:transform .22s ease,opacity .22s ease}
.modal-back.closing{opacity:0}
.modal-back.closing .modal{transform:translateY(12px) scale(.98);opacity:0}

/* --- 5. Button polish (lift + shadow on hover) --- */
.btn{transition:transform .16s ease,box-shadow .16s ease,background .16s ease,border-color .16s ease}
.btn-gold:hover,.btn-maroon:hover{transform:translateY(-1px);box-shadow:0 5px 16px rgba(138,36,50,.28)}
.btn-outline:hover,.btn-ghost:hover{transform:translateY(-1px);box-shadow:var(--shadow)}
.btn:active{transform:scale(.97)}

/* --- 6. Image fade-in on load (JS adds .img-fade to <html>) --- */
.img-fade img{opacity:0;transition:opacity .45s ease}
.img-fade img.loaded{opacity:1}

/* --- 7. Wishlist heart pop --- */
.wish-btn svg{transition:transform .2s ease}
.wish-btn.on svg{animation:heartPop .38s cubic-bezier(.34,1.56,.64,1)}
@keyframes heartPop{0%{transform:scale(1)}45%{transform:scale(1.4)}100%{transform:scale(1)}}

/* --- 8. Search suggest fade-in --- */
.search-suggest{animation:suggestIn .22s cubic-bezier(.4,0,.2,1)}
@keyframes suggestIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}

/* --- 9. Header shadow transition + bottom nav polish --- */
.header{transition:box-shadow .28s ease}
.bottom-nav a{transition:color .2s ease,transform .15s ease}
.bottom-nav a:active{transform:scale(.94)}
.bottom-nav a .bn-ico{transition:transform .22s cubic-bezier(.34,1.56,.64,1)}

/* --- 10. Card entrance stagger helper (used with reveal) --- */
.pgrid .pcard.reveal:nth-child(2){transition-delay:.05s}
.pgrid .pcard.reveal:nth-child(3){transition-delay:.1s}
.pgrid .pcard.reveal:nth-child(4){transition-delay:.15s}
.pgrid .pcard.reveal:nth-child(5){transition-delay:.2s}
.pgrid .pcard.reveal:nth-child(6){transition-delay:.25s}
.pgrid .pcard.reveal:nth-child(7){transition-delay:.3s}
.pgrid .pcard.reveal:nth-child(8){transition-delay:.35s}

/* --- 11. Toast slide-up polish --- */
.toast{animation:toastUp .32s cubic-bezier(.34,1.3,.64,1)}
@keyframes toastUp{from{opacity:0;transform:translateY(16px) scale(.97)}to{opacity:1;transform:none}}

/* --- 12. Link underline sweep for nav --- */
.main-nav a{position:relative;transition:color .2s ease}
.main-nav a::after{content:'';position:absolute;left:0;bottom:-4px;width:0;height:2px;background:var(--maroon);transition:width .25s ease}
.main-nav a:hover::after,.main-nav a.on::after{width:100%}

/* ============ v3.6.1 — Auth Page Animations ============ */
/* --- Entrance: side panel slides in, card rises up --- */
.auth-wrap-v2 .auth-side{animation:authSideIn .55s cubic-bezier(.4,0,.2,1) both;position:relative;overflow:hidden}
.auth-wrap-v2 .auth-card-v2{animation:authCardIn .55s .1s cubic-bezier(.4,0,.2,1) both}
@keyframes authSideIn{from{opacity:0;transform:translateX(-26px)}to{opacity:1;transform:none}}
@keyframes authCardIn{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
/* Gentle shine sweep on the side panel */
.auth-side::after{content:'';position:absolute;inset:0;background:linear-gradient(115deg,transparent 35%,rgba(255,215,112,.07) 50%,transparent 65%);animation:sideShine 7s ease infinite;pointer-events:none}
@keyframes sideShine{from{transform:translateX(-110%)}to{transform:translateX(110%)}}
/* Demo box delayed entrance */
.auth-card-v2 .demo-box{animation:authCardIn .5s .25s cubic-bezier(.4,0,.2,1) both}

/* --- Error shake --- */
@keyframes shakeX{10%,90%{transform:translateX(-1px)}20%,80%{transform:translateX(2px)}30%,50%,70%{transform:translateX(-5px)}40%,60%{transform:translateX(5px)}}
.shake{animation:shakeX .45s ease}

/* --- Password strength meter --- */
.pw-meter{height:6px;border-radius:99px;background:var(--soft2);overflow:hidden;margin-top:7px}
.pw-meter-fill{height:100%;width:0;border-radius:99px;transition:width .35s cubic-bezier(.4,0,.2,1),background .35s ease}
.pw-meter-fill.weak{background:#ef4444;width:25%}
.pw-meter-fill.fair{background:#f59e0b;width:50%}
.pw-meter-fill.good{background:#10b981;width:75%}
.pw-meter-fill.strong{background:#059669;width:100%}
.pw-label{font-size:.76rem;font-weight:600;margin-top:5px;min-height:1em}

/* --- Login success overlay --- */
.login-success{position:fixed;inset:0;background:rgba(255,255,255,.94);z-index:300;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;animation:fadeIn .25s ease;text-align:center;padding:20px}
.login-success .check-circle{width:86px;height:86px;border-radius:50%;background:#ecfdf5;border:2px solid #a7f3d0;display:flex;align-items:center;justify-content:center;color:#059669;animation:checkPop .55s cubic-bezier(.34,1.56,.64,1)}
.login-success .check-circle svg{width:46px;height:46px}
@keyframes checkPop{from{transform:scale(.3);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

/* --- OTP input focus pop --- */
#eotpCode:focus,#otpCode:focus{transform:scale(1.02)}
#eotpCode,#otpCode{transition:transform .18s ease,border-color .15s ease,box-shadow .15s ease}

/* --- Tab switch: smoother slide --- */
.auth-panel{animation:panelIn .32s cubic-bezier(.4,0,.2,1)}
@keyframes panelIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.auth-tab{transition:background .2s ease,color .2s ease,box-shadow .2s ease,transform .15s ease}
.auth-tab:active{transform:scale(.97)}

/* --- Input focus glow (auth) --- */
.auth-card-v2 .input{transition:border-color .18s ease,box-shadow .18s ease,transform .18s ease}
.auth-card-v2 .input:focus{transform:translateY(-1px)}

/* ============ v3.6.2 — Auth: form first on mobile (no scrolling to type) ============ */
@media(max-width:768px){
  /* Card (form) appears FIRST, side panel below — form visible immediately */
  .auth-wrap-v2 .auth-card-v2{order:-1;border-radius:var(--radius-lg) var(--radius-lg) 0 0;border-left:1px solid var(--line);padding:28px 22px 24px}
  .auth-wrap-v2 .auth-side{border-radius:0 0 var(--radius-lg) var(--radius-lg);padding:22px}
  .auth-wrap-v2 .auth-side h2{font-size:1.3rem}
  .auth-wrap-v2 .auth-side ul{font-size:.84rem;gap:8px;margin-top:12px}
  .auth-wrap-v2{padding-top:18px}
}
