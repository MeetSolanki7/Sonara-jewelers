/* ---------------- Cart / Wishlist / Checkout ---------------- */
async function getCartData(){
  if(state.user) return api('/api/cart');
  const all = state.productsCache.length ? state.productsCache : await api('/api/products');
  const items = state.guestCart.map(ci=>{ const p = all.find(x=>x.id===ci.productId); return p?{ productId:p.id, name:p.name, image:p.image, metal:p.metal, price:p.price, mrp:p.mrp, stock:p.stock, qty:ci.qty }:null; }).filter(Boolean);
  const subtotal = items.reduce((s,i)=>s+i.price*i.qty,0), mrpTotal = items.reduce((s,i)=>s+i.mrp*i.qty,0);
  return { items, subtotal, mrpTotal, savings: mrpTotal-subtotal, count: items.reduce((s,i)=>s+i.qty,0) };
}
async function setCartQty(productId, qty){
  if(state.user) return api('/api/cart/'+productId, { method:'PUT', body:{ qty } });
  const it = state.guestCart.find(i=>i.productId===productId); if(it) it.qty = qty;
  localStorage.setItem('sonara_guest_cart', JSON.stringify(state.guestCart));
  return getCartData();
}
async function removeCartItem(productId){
  if(state.user) return api('/api/cart/'+productId, { method:'DELETE' });
  state.guestCart = state.guestCart.filter(i=>i.productId!==productId);
  localStorage.setItem('sonara_guest_cart', JSON.stringify(state.guestCart));
  return getCartData();
}
function cartSummaryHTML(cart, coupon){
  const s = state.settings || {};
  const disc = coupon ? coupon.discount : 0;
  const afterDisc = cart.subtotal - disc;
  const ship = cart.count===0 ? 0 : (afterDisc >= (s.freeShipAbove||999) ? 0 : (s.shippingFee||79));
  const pct = Math.min(100, Math.round(afterDisc / (s.freeShipAbove||999) * 100));
  return { ship, total: afterDisc + ship, html: `
    <div class="ship-progress">${ship===0 && cart.count?`You unlocked <b>FREE insured shipping!</b>`:`Add <b>${fmt(Math.max(0,(s.freeShipAbove||999)-afterDisc))}</b> more for FREE insured shipping`}<div class="ship-bar"><div style="width:${pct}%"></div></div></div>
    <div class="sum-row"><span>Subtotal (${cart.count} item${cart.count===1?'':'s'})</span><span>${fmt(cart.subtotal)}</span></div>
    ${cart.savings?`<div class="sum-row" style="color:var(--green)"><span>MRP savings</span><span>− ${fmt(cart.savings)}</span></div>`:''}
    ${disc?`<div class="sum-row" style="color:var(--green)"><span>Coupon (${esc(coupon.code)})</span><span>− ${fmt(disc)}</span></div>`:''}
    <div class="sum-row"><span>Insured shipping</span><span>${ship===0?'<b style="color:var(--green)">FREE</b>':fmt(ship)}</span></div>
    <div class="sum-row total"><span>Total to Pay</span><span>${fmt(afterDisc+ship)}</span></div>
    <p class="muted small">Inclusive of GST • Secure checkout • COD available</p>` };
}
async function viewCart(){
  const v = $('#view');
  v.innerHTML = `<div class="page-loading"><div class="spinner"></div><p>Loading your cart…</p></div>`;
  let cart = await getCartData();
  state.cartCount = cart.count; updateBadges();
  if(!cart.items.length){
    v.innerHTML = `<div class="wrap" style="padding-top:30px">${emptyState(icon('bag',48),'Your cart is empty','Beautiful jewellery is waiting for you — start with our bestsellers in gold, silver & imitation.','#/shop','Start Shopping')}</div>`;
    return;
  }
  const render = ()=>{
    const sum = cartSummaryHTML(cart, state.checkoutCoupon);
    v.innerHTML = `<div class="two-col">
      <div><div class="dash-head"><div><h2>My Cart</h2><p>${cart.count} item${cart.count===1?'':'s'} • Prices include GST</p></div><a class="btn btn-ghost btn-sm" href="#/shop">← Continue Shopping</a></div>
      <div class="card" style="padding:6px 22px">${cart.items.map(i=>`
        <div class="cart-item" data-row="${i.productId}">
          <a href="#/product/${i.productId}"><img src="${esc(i.image)}" alt=""></a>
          <div style="flex:1;min-width:180px"><a href="#/product/${i.productId}" style="font-weight:700">${esc(i.name)}</a>
            <div>${metalPill(i.metal)} <span class="muted small">${i.stock<=5?`Only ${i.stock} left`:'In stock'}</span></div>
            <div class="price-row"><span class="price">${fmt(i.price)}</span>${i.mrp>i.price?`<span class="mrp">${fmt(i.mrp)}</span>`:''}</div>
          </div>
          <div style="text-align:right">
            <div class="qty-box"><button data-cqty="-1" data-id="${i.productId}">−</button><b>${i.qty}</b><button data-cqty="1" data-id="${i.productId}">+</button></div>
            <div style="font-weight:800;margin:8px 0">${fmt(i.price*i.qty)}</div>
            <button class="btn btn-danger btn-sm" data-cremove="${i.productId}">Remove</button>
          </div>
        </div>`).join('')}</div>
      <p class="muted small" style="margin-top:12px">Gold orders ship in sealed, insured, tamper-proof packaging with BIS/HUID card.</p></div>
      <div class="card" style="position:sticky;top:120px"><h3>Price Summary</h3>
        ${state.user?`<div class="coupon-row" style="margin-bottom:6px"><input class="input" id="couponInput" placeholder="Coupon e.g. WELCOME10" value="${state.checkoutCoupon?esc(state.checkoutCoupon.code):''}"><button class="btn btn-maroon" id="applyCoupon">Apply</button></div>
        <p class="small muted" id="couponMsg">${state.checkoutCoupon?''+esc(state.checkoutCoupon.message||'Coupon applied'):'Try WELCOME10 • GOLD5 • SILVER15 • FESTIVE20'}</p>`:`<p class="small muted"><a href="#/login" style="font-weight:800;text-decoration:underline">Login</a> to apply coupons like WELCOME10 & GOLD5.</p>`}
        <div style="margin-top:12px">${sum.html}</div>
        <button class="btn btn-gold btn-lg btn-block" id="toCheckout" style="margin-top:14px">Proceed to Checkout →</button>
        <a class="btn btn-ghost btn-block" href="#/wishlist" style="margin-top:8px">View Wishlist</a>
      </div></div>`;
    $$('[data-cqty]', v).forEach(b=>b.onclick = async ()=>{
      const it = cart.items.find(x=>x.productId===b.dataset.id);
      const nq = it.qty + (+b.dataset.cqty);
      if(nq < 1) return;
      if(nq > it.stock){ toast(`Only ${it.stock} available in stock`, 'err'); return; }
      it.qty = nq; cart = await setCartQty(b.dataset.id, nq); state.cartCount = cart.count; updateBadges(); render(); // optimistic qty + server sync
    });
    $$('[data-cremove]', v).forEach(b=>b.onclick = async ()=>{
      const row = $(`[data-row="${b.dataset.cremove}"]`); if(row) row.style.opacity='.35'; // optimistic fade
      cart = await removeCartItem(b.dataset.cremove); state.cartCount = cart.count; updateBadges();
      toast('Removed from cart');
      if(!cart.items.length) viewCart(); else render();
    });
    const ac = $('#applyCoupon');
    if(ac) ac.onclick = async ()=>{
      const code = $('#couponInput').value.trim().toUpperCase();
      if(!code){ $('#couponMsg').textContent='Enter a coupon code first.'; return; }
      setLoading(ac, true, 'Checking…');
      try { const r = await api('/api/coupons/validate', { method:'POST', body:{ code, subtotal:cart.subtotal } }); state.checkoutCoupon = r; toast(r.message); render(); }
      catch(e){ $('#couponMsg').textContent = e.message; setLoading(ac,false); }
    };
    $('#toCheckout').onclick = ()=>{ if(requireLogin('#/checkout')) go('#/checkout'); };
  };
  render();
}

async function viewWishlist(inDash=false){
  const v = $('#view');
  let products = [];
  if(state.user){ try { products = (await api('/api/wishlist')).products; } catch(e){} }
  else {
    const all = state.productsCache.length ? state.productsCache : await api('/api/products').catch(()=>[]);
    products = [...state.wishlist].map(id=>all.find(p=>p.id===id)).filter(Boolean);
  }
  const inner = products.length
    ? `<div class="pgrid">${products.map(productCard).join('')}</div>`
    : emptyState(icon('heart',48),'Your wishlist is empty','Tap the heart on any jewellery you love and it will wait for you here.','#/shop','Discover Jewellery');
  if(inDash) return inner;
  v.innerHTML = `<div class="wrap" style="padding-top:30px;padding-bottom:40px"><div class="dash-head"><div><h2>My Wishlist</h2><p>${products.length} saved piece${products.length===1?'':'s'}${state.user?'':' • Login to sync your wishlist across devices'}</p></div></div>${inner}</div>`;
}

async function viewCheckout(){
  if(!requireLogin('#/checkout')) return;
  const v = $('#view');
  v.innerHTML = `<div class="page-loading"><div class="spinner"></div><p>Preparing secure checkout…</p></div>`;
  const [cart, addrs] = await Promise.all([api('/api/cart'), api('/api/addresses')]);
  if(!cart.items.length){ v.innerHTML = `<div class="wrap" style="padding-top:30px">${emptyState(icon('bag',48),'Nothing to checkout','Your cart is empty. Add some jewellery first!','#/shop','Shop Now')}</div>`; return; }
  let coupon = state.checkoutCoupon;
  // re-validate saved coupon against current subtotal
  if(coupon){ try { coupon = await api('/api/coupons/validate',{method:'POST',body:{code:coupon.code, subtotal:cart.subtotal}}); state.checkoutCoupon = coupon; } catch(e){ coupon=null; state.checkoutCoupon=null; } }
  const sum = cartSummaryHTML(cart, coupon);
  const def = addrs.find(a=>a.isDefault) || addrs[0];
  v.innerHTML = `<div class="two-col">
    <div>
      <div class="dash-head"><div><h2>Secure Checkout</h2><p>Almost yours — confirm address & payment</p></div></div>
      <div class="steps"><span class="step done"><span class="n">✓</span> Cart</span><span class="step-line"></span><span class="step now"><span class="n">2</span> Address & Payment</span><span class="step-line"></span><span class="step"><span class="n">3</span> Done</span></div>
      <div class="card" style="margin-bottom:18px"><h3>Delivery Address</h3><div id="addrList">
        ${addrs.length ? addrs.map(a=>`<label class="addr-card ${def&&a.id===def.id?'sel':''}" style="display:flex;gap:12px;cursor:pointer"><input type="radio" name="addrSel" value="${a.id}" ${def&&a.id===def.id?'checked':''} style="margin-top:4px;accent-color:var(--gold)"><span><b>${esc(a.name)}</b> <span class="pill pill-gold">${esc(a.label)}</span>${a.isDefault?' <span class="pill pill-green">Default</span>':''}<br><span class="muted">${esc(a.line1)}, ${esc(a.city)}, ${esc(a.state)} — <b>${esc(a.pincode)}</b> • ${esc(a.phone)}</span></span></label>`).join('') : '<p class="muted">No saved address yet — add one below to continue.</p>'}
      </div>
      <button class="btn btn-outline btn-sm" id="toggleAddrForm">Add New Address</button>
      <form id="addrForm" class="hidden" style="margin-top:16px">
        <div class="frow"><div class="field"><label>Full Name *</label><input class="input" id="aName" required value="${esc(state.user.name)}"></div><div class="field"><label>Mobile *</label><input class="input" id="aPhone" required maxlength="10" value="${esc(state.user.phone)}"></div></div>
        <div class="field"><label>Address (house no, street, landmark) *</label><input class="input" id="aLine" required placeholder="e.g. B-12, Shivalaya Heights, Kalavad Road"></div>
        <div class="frow"><div class="field"><label>City *</label><input class="input" id="aCity" required placeholder="Rajkot"></div><div class="field"><label>State *</label><input class="input" id="aState" required placeholder="Gujarat"></div></div>
        <div class="frow"><div class="field"><label>Pincode *</label><input class="input" id="aPin" required maxlength="6" placeholder="360005"></div><div class="field"><label>Label</label><select class="input" id="aLabel"><option>Home</option><option>Office</option><option>Other</option></select></div></div>
        <button class="btn btn-gold" type="submit">Save & Use This Address</button>
      </form></div>
      <div class="card"><h3> Payment Method</h3>
        <label class="pay-opt"><input type="radio" name="pay" value="Razorpay" checked><span><b>Pay Online — Razorpay</b> (UPI • Cards • NetBanking • EMI)<br><span class="muted small">Secure Razorpay window opens on Place Order. Test mode until owner adds live keys.</span></span></label>
        <label class="pay-opt"><input type="radio" name="pay" value="COD"><span><b> Cash on Delivery</b><br><span class="muted small">Pay at your doorstep • Please keep exact change / UPI ready</span></span></label>
        <div id="payExtra"><p class="muted small">100% secure payments by Razorpay. Gold orders ship insured in sealed packs.</p></div>
      </div>
    </div>
    <div class="card" style="position:sticky;top:120px"><h3>Order Summary</h3>
      ${cart.items.map(i=>`<div style="display:flex;gap:10px;align-items:center;margin-bottom:11px"><img src="${esc(i.image)}" style="width:52px;height:52px;border-radius:11px;object-fit:cover;border:1px solid var(--line)"><div style="flex:1;font-size:.86rem"><b>${esc(i.name)}</b><br><span class="muted">Qty ${i.qty} × ${fmt(i.price)}</span></div><b>${fmt(i.price*i.qty)}</b></div>`).join('')}
      <div class="coupon-row" style="margin:12px 0 4px"><input class="input" id="coCode" placeholder="Coupon code" value="${coupon?esc(coupon.code):''}"><button class="btn btn-maroon" id="coApply">Apply</button></div>
      <p class="small muted" id="coMsg">${coupon?''+esc(coupon.message||'Coupon applied'):'Try WELCOME10 • GOLD5 • FESTIVE20'}</p>
      <div id="coSummary" style="margin-top:10px">${sum.html}</div>
      <button class="btn btn-gold btn-lg btn-block" id="placeOrder" style="margin-top:14px">Place Order • ${fmt(sum.total)}</button>
      <p class="muted small center" style="margin-top:9px">By placing the order you agree to our demo T&C. No real payment is charged.</p>
    </div></div>`;
  const addrTextById = id => { const a = addrs.find(x=>x.id===id); return a ? `${a.name}, ${a.line1}, ${a.city}, ${a.state} — ${a.pincode} (${a.phone})` : ''; };
  $$('input[name=addrSel]').forEach(r=>r.addEventListener('change', ()=>{ $$('.addr-card').forEach(c=>c.classList.remove('sel')); r.closest('.addr-card').classList.add('sel'); }));
  $('#toggleAddrForm').onclick = ()=>$('#addrForm').classList.toggle('hidden');
  if(!addrs.length) $('#addrForm').classList.remove('hidden');
  $('#addrForm').onsubmit = async e=>{
    e.preventDefault(); const btn = e.target.querySelector('button'); setLoading(btn,true,'Saving…');
    try {
      const a = await api('/api/addresses', { method:'POST', body:{ name:$('#aName').value, phone:$('#aPhone').value, line1:$('#aLine').value, city:$('#aCity').value, state:$('#aState').value, pincode:$('#aPin').value, label:$('#aLabel').value, isDefault:true } });
      toast('Address saved'); viewCheckout();
    } catch(err){ toast(err.message,'err'); setLoading(btn,false); }
  };
  $$('input[name=pay]').forEach(r=>r.addEventListener('change', ()=>{
    const val = document.querySelector('input[name=pay]:checked').value;
    $('#payExtra').innerHTML = val==='COD'
      ? `<p class="form-ok"> Pay <b>${fmt(sum.total)}</b> in cash / UPI when your jewellery arrives. Please verify the sealed box before paying.</p>`
      : `<p class="muted small">Razorpay secure window (UPI / Card / EMI) will open when you tap Place Order. ${(state.pubConfig&&state.pubConfig.paymentsMode==='test')?'Store is in TEST payment mode — no real money will be charged.':''}</p>`;
  }));
  $('#coApply').onclick = async ()=>{
    const code = $('#coCode').value.trim().toUpperCase(); if(!code) return;
    try { const r = await api('/api/coupons/validate',{method:'POST',body:{code, subtotal:cart.subtotal}}); state.checkoutCoupon = r; toast(r.message); viewCheckout(); }
    catch(e){ $('#coMsg').textContent = e.message; }
  };
  $('#placeOrder').onclick = async e=>{
    const sel = document.querySelector('input[name=addrSel]:checked');
    if(!sel){ toast('Please add / select a delivery address', 'err'); $('#addrForm').classList.remove('hidden'); window.scrollTo({top:0,behavior:'smooth'}); return; }
    const pay = document.querySelector('input[name=pay]:checked').value;
    const btn = e.currentTarget;
    setLoading(btn, true, pay==='Razorpay' ? 'Opening secure payment…' : 'Placing your order…');
    try {
      let payRef = null;
      if(pay==='Razorpay') payRef = await payOnline(); // Razorpay / TEST modal + server verify
      const order = await api('/api/orders', { method:'POST', body:{ address: addrTextById(sel.value), payment: pay, coupon: state.checkoutCoupon ? state.checkoutCoupon.code : '' } });
      if(payRef){ try { await api('/api/orders/'+order.id+'/payment-ref', { method:'POST', body: payRef }); } catch(_e){} }
      state.checkoutCoupon = null; state.cartCount = 0; updateBadges();
      go('#/order-success/' + order.id);
    } catch(err){ toast(err.message,'err'); setLoading(btn,false); }
  };
}
