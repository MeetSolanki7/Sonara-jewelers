async function toggleWish(id, btn){
  const was = state.wishlist.has(id);
  // optimistic
  if(was) state.wishlist.delete(id); else state.wishlist.add(id);
  $$(`[data-action="wish"][data-id="${id}"]`).forEach(b=>{ b.classList.toggle('on', !was); b.innerHTML = icon('heart',18); });
  const pdBtn = $('#pdWish'); if(pdBtn && pdBtn.dataset.id===id) pdBtn.innerHTML = icon('heart',16)+' '+( !was?'Wishlisted':'Add to Wishlist');
  updateBadges();
  if(!state.user){
    localStorage.setItem('sonara_guest_wish', JSON.stringify([...state.wishlist]));
    toast(was?'Removed from wishlist':'Added to wishlist (login to sync everywhere)');
    if(location.hash.startsWith('#/wishlist') || location.hash.startsWith('#/dashboard/wishlist')) route();
    return;
  }
  try {
    const r = await api('/api/wishlist/toggle', { method:'POST', body:{ productId:id } });
    state.wishlist = new Set(r.ids); updateBadges();
    toast(r.wished ? 'Added to wishlist' : 'Removed from wishlist');
    if(location.hash.startsWith('#/wishlist') || location.hash.startsWith('#/dashboard/wishlist')) route();
  } catch(e){
    // rollback
    if(was) state.wishlist.add(id); else state.wishlist.delete(id);
    $$(`[data-action="wish"][data-id="${id}"]`).forEach(b=>{ b.classList.toggle('on', was); b.innerHTML = icon('heart',18); });
    updateBadges(); toast(e.message, 'err');
  }
}
async function addToCart(id, qty=1, btn=null, silent=false){
  state.cartCount += qty; updateBadges(); // optimistic badge
  if(btn) setLoading(btn, true, 'Adding…');
  try {
    if(state.user){
      const cart = await api('/api/cart', { method:'POST', body:{ productId:id, qty } });
      state.cartCount = cart.count; updateBadges();
    } else {
      const ex = state.guestCart.find(i=>i.productId===id);
      if(ex) ex.qty += qty; else state.guestCart.push({ productId:id, qty });
      localStorage.setItem('sonara_guest_cart', JSON.stringify(state.guestCart));
      state.cartCount = state.guestCart.reduce((s,i)=>s+i.qty,0); updateBadges();
    }
    if(!silent) toast('Added to cart <a href="#/cart" style="color:#ffd970;font-weight:800">View Cart →</a>');
    return true;
  } catch(e){
    state.cartCount = Math.max(0, state.cartCount - qty); updateBadges();
    toast(e.message, 'err'); return false;
  } finally { if(btn) setLoading(btn, false); }
}

/* Global click delegation for optimistic actions */
document.addEventListener('click', e=>{
  const el = e.target.closest('[data-action]');
  if(!el) return;
  const { action, id } = el.dataset;
  if(action==='wish'){ e.preventDefault(); toggleWish(id, el); }
  if(action==='add-cart'){ addToCart(id, 1, el); }
  if(action==='buy-now'){ addToCart(id, +(el.dataset.qty||1), el, true).then(ok=>{ if(ok){ if(requireLogin('#/checkout')) go('#/checkout'); } }); }
  if(action==='logout'){ logout(); }
  if(action==='close-modal'){ closeModal(); }
});

