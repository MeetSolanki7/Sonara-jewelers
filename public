    const tryGoogle = ()=>{
      if(!window.google || !google.accounts || !$('#gBtn')) return false;
      google.accounts.id.initialize({ client_id: cfg.googleClientId, callback: async (resp)=>{
        try { const data = await api('/api/auth/google', { method:'POST', body:{ credential: resp.credential } }); await afterLoginPro(data); }
        catch(err){ toast(err.message, 'err'); }
      }});
      google.accounts.id.renderButton($('#gBtn'), { theme:'outline', size:'large', text:'continue_with', width: 320 });
      return true;
    };
    if(!tryGoogle()){ let n=0; const iv=setInterval(()=>{ if(tryGoogle() || ++n>20) clearInterval(iv); }, 400); }
  }
}
