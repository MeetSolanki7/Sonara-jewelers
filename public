const icon = (name, size=20) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]||''}</svg>`;

function stars(r, count){
  const full = Math.round(+r || 0);
  return `<span class="stars">${'★'.repeat(full)}${'☆'.repeat(5-full)} <span>${(+r).toFixed(1)}${count!=null?` (${count})`:''}</span></span>`;
}
function statusPill(s){
  const m = {'Pending':'pill-amber','Processing':'pill-blue','Shipped':'pill-blue','Out for Delivery':'pill-blue','Delivered':'pill-green','Cancelled':'pill-red','Paid':'pill-green','Pending (COD)':'pill-amber','Refunded':'pill-grey','Refund initiated':'pill-grey','Paid (COD collected)':'pill-green'};
  return `<span class="pill ${m[s]||'pill-grey'}">${esc(s)}</span>`;
}
function metalPill(m){ return `<span class="pill ${m==='Gold'?'pill-gold':m==='Silver'?'pill-silver':'pill-rose'}">${esc(m)}</span>`; }
async function api(path, opts={}){
  const sentToken = state.token;
  const res = await fetch(path, {
    method: opts.method || 'GET',
    // Send the login token by TWO headers: some preview/proxy layers strip Authorization.
    headers: { 'Content-Type':'application/json', ...(sentToken ? { Authorization:'Bearer '+sentToken, 'X-Auth-Token':sentToken } : {}) },
    body: opts.body ? JSON.stringify(opts.body) : undefined
  });
  let data = {};
  try { data = await res.json(); } catch(e){}
  if(!res.ok){
    const err = new Error(data.error || ('Request failed ('+res.status+')'));
    err.status = res.status;
    // Session problems (old demo login, expired/deleted account): log out cleanly + go to Login
    if(res.status===401 && !path.startsWith('/api/auth/') && !opts.soft && sentToken && state.token===sentToken){
      err.code = 'AUTH';
      if(state.token || state.user){
        state.token=''; state.user=null; state.cartCount=0;
        localStorage.removeItem('sonara_token'); localStorage.removeItem('sonara_user');
        try{ renderHeader(); }catch(_e){}
        toast('Session expired — please login again', 'err');
      }
      if(location.hash && location.hash!=='#/login') sessionStorage.setItem('sonara_redirect', location.hash);
      if(location.hash!=='#/login') go('#/login');
    }
    throw err;
  }
  return data;
}
function toast(msg, type='ok'){
  const t = document.createElement('div');
  t.className = 'toast ' + type;
  t.innerHTML = `<span class="t-ico">${icon(type==='err'?'alert':type==='info'?'info':'check', 18)}</span><span>${msg}</span><span class="t-bar"></span>`;
  $('#toastRoot').appendChild(t);
  setTimeout(()=>{ t.style.opacity='0'; t.style.transition='.3s'; setTimeout(()=>t.remove(), 320); }, 3400);
}
function setLoading(btn, on, label){
  if(!btn) return;
  if(on){ btn.dataset.orig = btn.innerHTML; btn.disabled = true; btn.innerHTML = `<span class="spin"></span> ${label||'Please wait…'}`; }
  else { btn.disabled = false; if(btn.dataset.orig) btn.innerHTML = btn.dataset.orig; }
}
function openModal(html, wide=false){
  $('#modalRoot').innerHTML = `<div class="modal-back" id="modalBack"><div class="modal ${wide?'wide':''}">${html}</div></div>`;
  $('#modalBack').addEventListener('click', e => { if(e.target.id==='modalBack') closeModal(); });
  document.body.style.overflow = 'hidden';
}
function closeModal(){
  const back = $('#modalBack');
  if(back){ back.classList.add('closing'); setTimeout(()=>{ const b=$('#modalBack'); if(b){ $('#modalRoot').innerHTML=''; } document.body.style.overflow=''; }, 220); }
  else { $('#modalRoot').innerHTML=''; document.body.style.overflow=''; }
}
function confirmBox(title, msg, btnLabel='Yes, continue'){
  return new Promise(resolve=>{
    openModal(`<div class="modal-head"><h3>${esc(title)}</h3><button class="x-btn" id="cfNo">✕</button></div>
      <p class="muted" style="margin-bottom:20px">${msg}</p>
      <div style="display:flex;gap:10px;justify-content:flex-end"><button class="btn btn-ghost" id="cfCancel">Cancel</button><button class="btn btn-maroon" id="cfYes">${esc(btnLabel)}</button></div>`);
    const done = v => { closeModal(); resolve(v); };
    $('#cfYes').onclick = ()=>done(true);
    $('#cfCancel').onclick = ()=>done(false);
    $('#cfNo').onclick = ()=>done(false);
  });
}
function emptyState(icon, title, msg, ctaHash, ctaLabel){
  return `<div class="empty"><div class="e-ico">${icon}</div><h3>${esc(title)}</h3><p>${esc(msg)}</p>${ctaHash?`<a class="btn btn-gold" href="${ctaHash}">${esc(ctaLabel||'Continue Shopping')}</a>`:''}</div>`;
}
function skeletons(n=8){
  return `<div class="pgrid">${Array.from({length:n}).map(()=>`<div class="skel"><div class="sk"></div><div class="skl" style="width:78%"></div><div class="skl" style="width:52%"></div><div class="skl" style="width:64%"></div></div>`).join('')}</div>`;
}
const delay = ms => new Promise(r=>setTimeout(r, ms));
function go(hash){ if(location.hash === hash) route(); else location.hash = hash; }
function requireLogin(nextHash){
  if(state.user && state.token) return true;
  if(state.user || state.token){ state.token=''; state.user=null; localStorage.removeItem('sonara_token'); localStorage.removeItem('sonara_user'); try{ renderHeader(); }catch(_e){} }
  sessionStorage.setItem('sonara_redirect', nextHash || location.hash || '#/');
  toast('Please login to continue', 'err');
  go('#/login'); return false;
}

/* ---------------- Header / badges / auth ---------------- */
function renderHeader(){
  const s = state.settings || {};
  if(s.announcement) $('#announce').textContent = s.announcement;
  $('#rateStrip').innerHTML = `<div class="rate-strip-in">
    <span>Today&apos;s indicative rates:</span>
    <span>Gold 22K <b>${fmt(s.gold22k||8945)}/g</b></span>
    <span>Gold 24K <b>${fmt(s.gold24k||9760)}/g</b></span>
    <span>Silver <b>${fmt(s.silver||112)}/g</b></span>
    <span>Free insured shipping over <b>${fmt(s.freeShipAbove||999)}</b></span>
    <span>Support: <b>${esc(s.supportPhone||'+91 98765 43210')}</b></span></div>`;
  $('#footerAddr').textContent = s.address || '';
  $('#footerContact').textContent = `${s.supportEmail||''} • ${s.supportPhone||''}`;
  // Live rate ticker — 3 pills per line, fade in/out as a group
  const tt = $('#tickerTrack');
  if(tt){
    const g22 = `<span class="tick-pill tick-gold">${icon('medal',14)} Gold 22K <b>${fmt(s.gold22k||8945)}/g</b></span>`;
    const g24 = `<span class="tick-pill tick-gold">${icon('medal',14)} Gold 24K <b>${fmt(s.gold24k||9760)}/g</b></span>`;
    const sil = `<span class="tick-pill tick-silver">${icon('diamond',14)} Silver 925 <b>${fmt(s.silver||112)}/g</b></span>`;
    const ship = `<span class="tick-pill tick-green">${icon('truck',14)} Free insured shipping over <b>${fmt(s.freeShipAbove||999)}</b></span>`;
    const ret = `<span class="tick-pill tick-blue">${icon('refresh',14)} 7-day returns • Lifetime exchange</span>`;
    const bis = `<span class="tick-pill tick-rose">${icon('shield',14)} BIS Hallmarked • HUID verified</span>`;
    const pay = `<span class="tick-pill tick-amber">${icon('cash',14)} COD • UPI • Cards • EMI available</span>`;
    const sale = `<span class="tick-pill tick-rose">${icon('sparkle',14)} Festive Sale — up to <b>55% OFF</b></span>`;
    const wel = `<span class="tick-pill tick-green">${icon('tag',14)} New here? <b>WELCOME10</b> = 10% OFF first order</span>`;
    tt._tickerItems = [
      `<div class="tick-group">${g22}${g24}${sil}</div>`,
      `<div class="tick-group">${ship}${ret}${bis}</div>`,
      `<div class="tick-group">${pay}${sale}${wel}</div>`,
    ];
    if(!tt._tickerStarted){
      tt._tickerStarted = true;
      let idx = 0;
      const showNext = ()=>{
        const arr = tt._tickerItems || [];
        if(!arr.length) return;
        tt.innerHTML = arr[idx % arr.length];
        tt.classList.remove('fading');
        idx++;
      };
      showNext();
      setInterval(()=>{
        tt.classList.add('fading');
        setTimeout(showNext, 800);
      }, 4200);
    }
  }
  const area = $('#authArea');
  if(state.user && state.token){
    const dash = state.user.role==='admin' ? '#/admin' : '#/dashboard';
    area.innerHTML = `<a class="user-chip" href="${dash}"><span class="avatar">${esc(state.user.name.trim()[0].toUpperCase())}</span><span>${esc(state.user.name.split(' ')[0])}${state.user.role==='admin'?' • Admin':''}</span></a>`;
  } else {
    area.innerHTML = `<a class="btn btn-maroon btn-sm" href="#/login" style="margin-left:6px">Login / Register</a>`;
  }
  updateBadges();
}
function updateBadges(){
  const w = state.wishlist.size;
  [['#wishBadge', w], ['#cartBadge', state.cartCount], ['#wishBadgeM', w], ['#cartBadgeM', state.cartCount]].forEach(([sel, n]) => {
    const el = $(sel); if(!el) return;
    el.textContent = n; el.classList.toggle('hidden', n===0);
  });
}
async function syncCartWish(){
  if(state.user){
    try {
      const [cart, wish] = await Promise.all([api('/api/cart',{soft:true}), api('/api/wishlist',{soft:true})]);
      state.cartCount = cart.count;
      // merge any guest wishlist ids not yet on server (best effort, once)
      state.wishlist = new Set(wish.ids);
    } catch(e){ state.cartCount = 0; }
  } else {
    state.cartCount = state.guestCart.reduce((s,i)=>s+i.qty,0);
  }
  updateBadges();
}
async function mergeGuestCart(){
  if(!state.user || !state.guestCart.length) return;
  for(const it of state.guestCart){ try { await api('/api/cart', { method:'POST', body: it, soft:true }); } catch(e){} }
  state.guestCart = []; localStorage.setItem('sonara_guest_cart','[]');
}
function setSession(token, user){
  if(!token || !user) return;
  state.token = token; state.user = user;
  localStorage.setItem('sonara_token', token);
  localStorage.setItem('sonara_user', JSON.stringify(user));
  // Cookie copy as a third delivery route (same 7-day lifetime as the token)
  try{ document.cookie = 'sonara_token=' + encodeURIComponent(token) + '; Path=/; Max-Age=' + (7*24*3600) + '; SameSite=Lax' + (location.protocol==='https:' ? '; Secure' : ''); }catch(_e){}
}
function logout(){
  state.token=''; state.user=null; state.cartCount=0;
  localStorage.removeItem('sonara_token'); localStorage.removeItem('sonara_user');
  try{ document.cookie='sonara_token=; Path=/; Max-Age=0'; }catch(_e){}
  state.wishlist = new Set(JSON.parse(localStorage.getItem('sonara_guest_wish')||'[]'));
  renderHeader(); toast('Logged out. See you soon!'); go('#/');
}

